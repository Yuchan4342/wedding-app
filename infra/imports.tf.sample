  id = "xxxxxxxxxx/aaaaaa/POST"
}
import {
  to = aws_api_gateway_integration.post_invitation_answers
  id = "xxxxxxxxxx/aaaaaa/POST"
}
import {
  to = aws_api_gateway_method_response.post_invitation_answers["200"]
  # <rest api id>/<resource id>/<http method>/<status code>
  id = "xxxxxxxxxx/aaaaaa/POST/200"
}
import {
  to = aws_api_gateway_method_response.post_invitation_answers["400"]
  id = "xxxxxxxxxx/aaaaaa/POST/400"
}
import {
  to = aws_api_gateway_method_response.post_invitation_answers["500"]
  id = "xxxxxxxxxx/aaaaaa/POST/500"
}
import {
