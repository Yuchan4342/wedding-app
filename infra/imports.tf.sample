  id = "xxxxxxxxxx/aaaaaa/POST/400"
}
import {
  to = aws_api_gateway_integration_response.post_invitation_answers["500"]
  id = "xxxxxxxxxx/aaaaaa/POST/500"
}
import {
  to = aws_api_gateway_method.get_invitation_answer
  id = "xxxxxxxxxx/bbbbbb/GET"
}
import {
  to = aws_api_gateway_integration.get_invitation_answer
  id = "xxxxxxxxxx/bbbbbb/GET"
}
import {
  to = aws_api_gateway_method_response.get_invitation_answer
  id = "xxxxxxxxxx/bbbbbb/GET/200"
}
import {
  to = aws_api_gateway_integration_response.get_invitation_answer
  id = "xxxxxxxxxx/bbbbbb/GET/200"
}
import {
  to = aws_api_gateway_method.options["invitation_answers"]
  id = "xxxxxxxxxx/aaaaaa/OPTIONS"
}
import {
  to = aws_api_gateway_integration.options["invitation_answers"]
  id = "xxxxxxxxxx/aaaaaa/OPTIONS"
}
import {
  to = aws_api_gateway_method_response.options["invitation_answers"]
  id = "xxxxxxxxxx/aaaaaa/OPTIONS/200"
}
import {
  to = aws_api_gateway_integration_response.options["invitation_answers"]
  id = "xxxxxxxxxx/aaaaaa/OPTIONS/200"
}
import {
  to = aws_api_gateway_method.options["invitation_answer"]
  id = "xxxxxxxxxx/bbbbbb/OPTIONS"
}
import {
  to = aws_api_gateway_integration.options["invitation_answer"]
  id = "xxxxxxxxxx/bbbbbb/OPTIONS"
}
import {
  to = aws_api_gateway_method_response.options["invitation_answer"]
  id = "xxxxxxxxxx/bbbbbb/OPTIONS/200"
}
import {
  to = aws_api_gateway_integration_response.options["invitation_answer"]
  id = "xxxxxxxxxx/bbbbbb/OPTIONS/200"
}
import {
  to = aws_api_gateway_stage.main
  # <rest api id>/<stage name>
  id = "xxxxxxxxxx/prod"
}

# NOTE: aws_api_gateway_deployment は triggers を API から読み取れないため、
# import しても初回 apply で作り直しになる。同じ構成の再デプロイなので実害はない。
# 取り込まずに Terraform 側で新しいデプロイを 1 つ作る運用でも問題ない。
# import {
#   to = aws_api_gateway_deployment.main
#   id = "xxxxxxxxxx/zzzzzz"
# }
